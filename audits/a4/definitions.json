  "feature_semantics": {
    "home_attack_sustainability": "minus: underlying output less sustainable than goals; zero: evidenced no discrepancy; plus: creation exceeds surface output; null: unsupported",
    "away_attack_sustainability": "same definition for away",
    "home_defensive_vulnerability": "minus: underlying defense more resilient than concessions; plus: underlying exposure worse; zero: evidenced no discrepancy; null: unsupported",
    "away_defensive_vulnerability": "same definition for away",
    "match_openness": "minus: less open interaction; plus: more open interaction; zero: evidenced continuity; null: no matchup support",
    "home_availability_impact": "minus: weaker available resources than observed sample; plus: stronger; zero: supported continuity; null: unverified",
    "away_availability_impact": "same definition for away",
    "schedule_imbalance": "minus: home disadvantaged; plus: away disadvantaged; zero: verified no imbalance; null: incomplete schedule"
  },
  "metric_definitions": {
    "arithmetic_mean_of_observed_match_values_v1": "sum of unique observed match-field values / actual available matches; expected denominator counts all declared eligible matches; conflict -> null",
    "paired_historical_score_summary_v1": "historical score predicate or sum across paired observed regulation-time goals / usable paired matches; never a target probability",
    "elapsed_since_latest_declared_fixture_not_verified_total_rest_v1": "(evidence cutoff - latest declared played time) in days; no claim of complete rest"
  }
